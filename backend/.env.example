# ==================== DJI Cloud API ====================
# 真实 DJI 设备接入，当前默认关闭。
# 凭证从 DJI 开发者平台（https://developer.dji.com）获取。
UAV_DJI_CLOUD_ENABLED=false
UAV_DJI_CLOUD_BASE_URL=https://api.dji.com
UAV_DJI_CLOUD_CLIENT_ID=
UAV_DJI_CLOUD_CLIENT_SECRET=
UAV_DJI_CLOUD_LICENSE=
UAV_DJI_CLOUD_CONNECT_TIMEOUT_MS=3000
UAV_DJI_CLOUD_READ_TIMEOUT_MS=5000
UAV_DJI_CLOUD_MAX_RETRIES=2

# ==================== MQTT Broker 连接 ====================
# 局域网方案：Broker 跑在本机或同网段机器，Dock 3 通过局域网直连。
# 公网方案：需 EMQX 部署在云服务器或 ngrok 穿透。
# 启用后，设置以下五项（必填）：
UAV_DJI_MQTT_ENABLED=false
UAV_DJI_MQTT_BROKER_URL=tcp://192.168.1.x:1883
UAV_DJI_MQTT_CLIENT_ID=uav-command-backend
UAV_DJI_MQTT_USERNAME=
UAV_DJI_MQTT_PASSWORD=
UAV_DJI_MQTT_GATEWAY_SN=

# ==================== MQTT 握手 ====================
# Dock 3 上云握手（config/bind_status/update_topo/organization_get/organization_bind）
# 启用前必须先把上面的 enabled + brokerUrl + gatewaySn 配好。
UAV_DJI_MQTT_HANDSHAKE_ENABLED=false
# 设备绑定码，从 DJI 控制台获取。仅从服务器环境变量读取，不写入代码或日志。
UAV_DJI_DEVICE_BINDING_CODE=

# ==================== 内嵌 MQTT Broker（仅本机联调）====================
# 设为 true 时启动内嵌 Moquette Broker（端口 1883），省去单独装 EMQX。
# 仅用于本机联调；Dock 3 直连本机 IP 时需要该 Broker 已启动。
UAV_DJI_MQTT_EMBEDDED_BROKER=false
# connect-timeout-ms=5000
# keep-alive-sec=30
# clean-session=true

# ==================== Redis ====================
UAV_REDIS_HOST=localhost
UAV_REDIS_PORT=6379

# ==================== 演示身份 ====================
UAV_DEMO_AUTH_ENABLED=true

# ==================== CORS ====================
UAV_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173