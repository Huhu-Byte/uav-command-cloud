# ============================================================
# 无人机巡检系统 - 统一部署环境变量
# ============================================================
# 使用方法：
#   Docker 部署：复制本文件为 deploy/.env，修改密码后执行 deploy/scripts/start-docker.cmd
#   本机部署：  复制本文件为 deploy/.env，按需开启 MQTT 后执行 deploy/scripts/start-local.cmd
#   不要把 .env 提交到 Git！

# ==================== 网站访问 ====================
# 浏览器访问端口（Docker 部署用）
UAV_WEB_PORT=8088
# 允许的前端来源（多个用逗号分隔）
UAV_ALLOWED_ORIGIN_PATTERNS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173

# ==================== MySQL 数据库 ====================
# Docker 部署时自动创建数据库；本机部署用 H2 文件数据库，以下变量不生效
MYSQL_DATABASE=uav_command
MYSQL_USER=uav_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# ==================== DJI Cloud API（真实设备接入）====================
# 默认关闭。正式接入前需要从 DJI 开发者平台获取凭证。
UAV_DJI_CLOUD_ENABLED=false
UAV_DJI_CLOUD_BASE_URL=https://api.dji.com
UAV_DJI_CLOUD_CLIENT_ID=
UAV_DJI_CLOUD_CLIENT_SECRET=
UAV_DJI_CLOUD_LICENSE=
UAV_DJI_CLOUD_CONNECT_TIMEOUT_MS=3000
UAV_DJI_CLOUD_READ_TIMEOUT_MS=5000
UAV_DJI_CLOUD_MAX_RETRIES=2

# ==================== MQTT Broker（机场数据通道）====================
# 机场和后端通过 MQTT Broker 交换数据。
# 局域网方案：Broker 跑在本机，Dock 3 通过局域网直连。
# 云端方案：EMQX 部署在云服务器，需公网 IP。
UAV_DJI_MQTT_ENABLED=false
UAV_DJI_MQTT_BROKER_URL=tcp://localhost:1883
UAV_DJI_MQTT_CLIENT_ID=uav-command-backend
UAV_DJI_MQTT_USERNAME=
UAV_DJI_MQTT_PASSWORD=
# 机场网关 SN（只填网关 SN，不填主控 SN 或链片 SN）
UAV_DJI_MQTT_GATEWAY_SN=

# ==================== MQTT 握手（机场上云对暗号）====================
# Dock 3 首次连接时需要完成 config/bind/organization/update_topo 四步握手。
# 启用前必须先配好上面的 MQTT_ENABLED + BROKER_URL + GATEWAY_SN。
UAV_DJI_MQTT_HANDSHAKE_ENABLED=false
# 设备绑定码，从 DJI 控制台获取，仅从服务器环境变量读取。
UAV_DJI_DEVICE_BINDING_CODE=

# ==================== 内嵌 MQTT Broker（仅本机联调）====================
# 设为 true 时自动启动本机 Mosquitto（需已安装到 C:\Program Files\Mosquitto\）。
# Docker 部署时不需要此项。
UAV_DJI_MQTT_EMBEDDED_BROKER=false
UAV_DJI_MQTT_BROKER_PORT=0

# ==================== Redis ====================
# Docker 部署时自动连接容器内 Redis；本机部署时默认排除 Redis 自动配置。
UAV_REDIS_HOST=localhost
UAV_REDIS_PORT=6379

# ==================== 演示身份（开发调试用）====================
# 本机开发时设为 true 可使用演示登录；Docker 部署时默认关闭。
UAV_DEMO_AUTH_ENABLED=true

# ==================== 前端配置（仅前端单独部署时需要）====================
# 留空时：开发环境由 Vite 转发到本机后端；部署环境请求同一网站域名。
# VITE_API_BASE_URL=
# VITE_WS_URL=
