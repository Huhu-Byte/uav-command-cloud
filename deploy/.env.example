# 澶嶅埗涓?deploy/.env 鍚庯紝鏇挎崲涓ら」瀵嗙爜銆備笉瑕佹妸 .env 鎻愪氦鍒?Git銆?MYSQL_DATABASE=uav_command
MYSQL_USER=uav_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# 缃戠珯璁块棶鍦板潃锛屼緥濡?http://127.0.0.1:8088
UAV_WEB_PORT=8088
UAV_ALLOWED_ORIGIN_PATTERNS=http://localhost:8088,http://127.0.0.1:8088

# ------------------- DJI 鐪熷疄璁惧鎺ュ叆锛堝綋鍓嶉粯璁ゅ叧闂級-------------------
# 姝ｅ紡鎺ュ叆鍓嶉渶瑕佷粠 DJI 寮€鍙戣€呭钩鍙拌幏鍙栦互涓嬩笁椤癸細
# UAV_DJI_CLOUD_ENABLED=true
# UAV_DJI_CLOUD_BASE_URL=https://api.dji.com
# UAV_DJI_CLOUD_CLIENT_ID=your-app-id
# UAV_DJI_CLOUD_CLIENT_SECRET=your-app-secret
# UAV_DJI_CLOUD_LICENSE=your-app-license
# UAV_DJI_NTP_SERVER_HOST=your-ntp-host
# UAV_DJI_NTP_SERVER_PORT=123

# ------------------- MQTT锛圗MQX锛夐厤缃紙榛樿鍏抽棴锛?------------------
# EMQX 宸插湪 compose.yaml 涓惎鍔紝浣嗗悗绔笉浼氳繛鎺ュ畠锛?# UAV_DJI_MQTT_ENABLED=false
# UAV_DJI_MQTT_HANDSHAKE_ENABLED=false
# UAV_DJI_MQTT_BROKER_URL=tcp://your-emqx-host:1883
# UAV_DJI_MQTT_CLIENT_ID=uav-command-backend
# UAV_DJI_MQTT_USERNAME=your-emqx-username
# UAV_DJI_MQTT_PASSWORD=your-emqx-password
# 浠呭～鍐欐満鍦虹綉鍏?SN锛屼笉濉富鎺?SN 鎴栭摥鐗?SN銆?# UAV_DJI_MQTT_GATEWAY_SN=your-dock-gateway-serial-number
# 设备绑定码，从 DJI 控制台获取，仅从服务器环境变量读取。
# UAV_DJI_DEVICE_BINDING_CODE=your-device-binding-code

# ------------------- Redis 閰嶇疆 -------------------
# Redis 宸插湪 compose.yaml 涓惎鍔紝榛樿鍦板潃锛?# UAV_REDIS_HOST=redis
# UAV_REDIS_PORT=6379
